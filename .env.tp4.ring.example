# 4dgx ring profile — the configuration this repo actually runs (sanitized).
# Derived from upstream .env.tp4.example plus the ring adaptations documented in
# README-dsv41.md. Values marked [measured] were A/B'd on the reference fleet.
#
# Key deviations from upstream defaults:
#   EP_SIZE=2                 straggler fix: NCCL/step 16.5 -> 10.2 ms [measured]
#   MAX_RUNNING_REQUESTS=12   8 -> 12; with --min-free-slots-delay 1 the 12th slot
#                             actually runs (c12 299 -> 385 tok/s) [measured]
#   MAX_TOTAL_TOKENS=5000000  KV pool; 4M was the upstream value
#   DSV41_SHARED_PAD_K=1      lossless: keeps the shared expert's down_proj K=576
#                             shape eligible for b12x (upstream PR #17)
#   EXTRA_SGLANG_ARGS         + --min-free-slots-delay 1
#   DSV41_CACHE_GIB=1         1 GiB / 16-way [measured]: Engram hit rate 0 -> 99.1%,
#                             c12 +6% (375 -> 399), prefill 100K +10.5%. An earlier
#                             "0 is better" reading was wrong -- packed shards make a
#                             miss one read, but the cache makes it zero reads 99% of
#                             the time. 1 GiB saturates; upstream PR#7's 4 GiB is not
#                             needed. Costs ~2 GB of long-prompt headroom (900K fails,
#                             600K is fine -- see docs/).
#
# Used by ./start-tp4.sh. Weights are node-local on all four machines
# (WEIGHTS_MODE=local); the NFS share machinery is skipped.

# ─── cluster (rank order follows the physical ring; WORKER_IPS order sets rank 1..3) ──
HEAD_IP=192.168.1.55
WORKER_IPS="192.168.1.56 192.168.1.58 192.168.1.57"
WORKER_HOSTS="192.168.1.56 192.168.1.58 192.168.1.57"
WORKER_USER=spark
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# ─── fabric (4-edge ring, both HCAs exposed, GID iron rule) ───────────────────
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly
NCCL_BUFFSIZE=8388608
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
# kernel-1031 GID table reorder: never auto-detect, always -1
NCCL_IB_GID_INDEX_FORCE=-1

# per-rank PEER_HCA (physical ring wiring, values from v2.1-vl-r1 production)
PEER_HCA_RANK0="1=rocep1s0f1,roceP2p1s0f1;3=rocep1s0f0,roceP2p1s0f0"
PEER_HCA_RANK1="0=rocep1s0f1,roceP2p1s0f1;2=rocep1s0f0,roceP2p1s0f0"
PEER_HCA_RANK2="1=rocep1s0f0,roceP2p1s0f0;3=rocep1s0f1,roceP2p1s0f1"
PEER_HCA_RANK3="0=rocep1s0f0,roceP2p1s0f0;2=rocep1s0f1,roceP2p1s0f1"

# static ring NCCL + general env, appended last so it wins duplicates
EXTRA_DOCKER_ENV="NCCL_ALGO=RING NCCL_IB_TIMEOUT=1000 NCCL_IB_RETRY_CNT=7 NCCL_IB_TOS=46 NCCL_IGNORE_CPU_AFFINITY=1 NCCL_MIN_NCHANNELS=4 NCCL_SET_THREAD_NAME=1 NCCL_NET_PLUGIN=none NCCL_TUNER_THRESHOLD=40960 NCCL_CUMEM_HOST_ENABLE=0 NCCL_DEBUG_FILE=/nccl-debug/nccl-%h-%p.log TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_DISABLE_VERSION_CHECK=1 PYTHONFAULTHANDLER=1 HF_HUB_OFFLINE=1 DSV41_SHARED_PAD_K=1 EP_SUPPRESS_NCCL_CHECK=1 SGLANG_RAGGED_VERIFY_MODE=static"

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:local
EXPECTED_SHARDS=48

# ─── weights: node-local, no NFS ──────────────────────────────────────────────
WEIGHTS_MODE=local
WORKER_MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
NFS_SHARE=0
WORKER_DIR=/home/spark/dsv41-4x-spark

# ─── parallelism (4 Sparks) ───────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=20000

# ─── serving: take over the 8899 loopback engine slot ─────────────────────────
# concurrency-proxy (8888) and the NAS LiteLLM gateway stay untouched:
# same port slot, same key, old served name kept as an alias.
PORT=8899
HOST=127.0.0.1
API_KEY=YOUR_API_KEY            # 任意强口令；与门户条目一致
SERVED_MODEL_NAME=deepseek-v4.1-flash,deepseek-v4-flash-vision-exp

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=1
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# Conservative first boot on the ring: 256K context / 2M KV pool.
# Ramp to 1M / 4M only after memguard-protected long-prompt tests (plan §Phase 3).
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL_SIZE=2048
MAX_TOTAL_TOKENS=5000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards (pack after the first stable boot) ──────────────────
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
# --enable-metrics: required by the RK3588 sparkdash panel token-rate path.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --enable-metrics --min-free-slots-delay 1"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────────────
# heads=64 / o_groups=8 / draft experts=128 / vocab=129280 all divide by 4:
# no TP padding on this profile.
DSV41_TP_PAD=0
